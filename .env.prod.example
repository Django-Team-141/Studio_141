# برای سرور (تنظیمات prod). کپی کنید به .env.prod و همه‌ی مقدارها را پر کنید.
DOMAIN=yourdomain.com
SECRET_KEY=change-me
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com
ADMIN_URL=choose-a-hard-to-guess-path/
TRUST_PROXY=True
HSTS_SECONDS=300

POSTGRES_DB=studio141
POSTGRES_USER=studio141
POSTGRES_PASSWORD=change-me-hex-only
DATABASE_URL=postgres://studio141:change-me-hex-only@db:5432/studio141

CONTACT_TELEGRAM=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_INSTAGRAM=

# اعلان درخواست‌ها در تلگرام: شماره‌ی چت هر عضو تیم در یک جای جدا (فقط عدد).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_2=
TELEGRAM_CHAT_ID_3=
TELEGRAM_CHAT_ID_4=
TELEGRAM_FULL_DETAILS=True
TELEGRAM_API_BASE=https://api.telegram.org

# ارسال به ایمیل: اختیاری است و می‌توانید همه را خالی بگذارید (تلگرام کافی است).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ORDER_NOTIFY_EMAIL_TO=

BACKUP_PASSPHRASE=change-me-hex-only