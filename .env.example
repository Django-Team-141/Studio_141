# برای کار روی سیستم خودتان (تنظیمات dev). این فایل را کپی کنید به .env و پر کنید.
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
ADMIN_URL=panel-141/

CONTACT_TELEGRAM=
CONTACT_EMAIL=
CONTACT_WHATSAPP=
CONTACT_INSTAGRAM=

# اعلان درخواست‌ها در تلگرام: شماره‌ی چت هر عضو تیم در یک جای جدا (فقط عدد).
# هر نفر باید قبلاً به ربات Start زده باشد. با دستور telegram_check شماره‌ها را پیدا می‌کنید.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_2=
TELEGRAM_CHAT_ID_3=
TELEGRAM_CHAT_ID_4=
TELEGRAM_FULL_DETAILS=True

# ارسال به ایمیل: اختیاری است و می‌توانید همه را خالی بگذارید (تلگرام کافی است).
# جیمیل نمی‌شود، چون «رمز برنامه» می‌خواهد. هر سرویس ایمیلی که SMTP دارد کار می‌کند.
# اگر سرویس پورت 465 خواست: EMAIL_PORT=465 و EMAIL_USE_SSL=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
ORDER_NOTIFY_EMAIL_TO=