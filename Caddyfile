{$DOMAIN} {
	encode zstd gzip
	header X-Content-Type-Options nosniff

	# اسم این فایل‌ها هش دارد و با هر تغییر عوض می‌شود، پس می‌شود برای همیشه کششان کرد
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
		}
	}
}